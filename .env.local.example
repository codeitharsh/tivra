# Live classes run on teacher-provided Microsoft Teams links (no API key needed).

# Email (Resend — https://resend.com). RESEND_API_KEY and RESEND_FROM_EMAIL
# are both required or sending silently no-ops (logged as 'failed' in
# email_logs). The RESEND_FROM_EMAIL domain must be verified in the Resend
# dashboard (SPF/DKIM DNS records) before it's allowed to send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@tivra.in
RESEND_FROM_NAME=Tivra
